FROM mcr.microsoft.com/dotnet/sdk:10.0
WORKDIR /src
COPY . .
RUN dotnet restore FirmezaApi.slnx
RUN dotnet build FirmezaApi.slnx --configuration Release --no-restore
CMD ["dotnet", "test", "Firmeza.Tests/Firmeza.Tests.csproj", "--configuration", "Release", "--no-build", "--no-restore", "--logger", "trx;LogFileName=firmeza.trx", "--results-directory", "/results"]
